<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical"
    android:padding="8dp">



        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="12dp"
            android:elevation="2dp">

            <TextView
                style="@style/TitleTextStyle"
                android:text="⏱️ Time Logger"
                android:layout_gravity="center"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Track your activities efficiently"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_gravity="center" />

        </LinearLayout>

        <!-- Category Selection Card -->
        <LinearLayout
            style="@style/CardStyle"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:padding="12dp">

            <TextView
                style="@style/SectionTitleStyle"
                android:text="📂 Select Category"
                android:drawablePadding="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp" />

            <Spinner
                android:id="@+id/category_spinner"
                style="@style/SpinnerStyle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Subcategory"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"
                android:layout_marginTop="8dp" />

            <Spinner
                android:id="@+id/subcategory_spinner"
                style="@style/SpinnerStyle" />

        </LinearLayout>

        <!-- Action Buttons Card -->
        <LinearLayout
            style="@style/CardStyle"
            android:orientation="vertical"
            android:layout_marginBottom="8dp"
            android:padding="12dp">

            <TextView
                style="@style/SectionTitleStyle"
                android:text="🎯 Actions" />

            <Button
                android:id="@+id/start_button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/button_primary"
                android:textColor="@color/text_white"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="🚀 START NEW ACTIVITY"
                android:layout_margin="2dp" />

            <Button
                android:id="@+id/stop_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="⏹️ STOP CURRENT ACTIVITY"
                android:layout_margin="2dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/export_button"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/button_secondary"
                android:textColor="@color/primary_blue"
                android:textSize="12sp"
                android:textStyle="bold"
                android:text="📊 EXPORT CSV"
                android:layout_margin="2dp" />

        </LinearLayout>

        <!-- History Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:layout_margin="8dp"
            android:padding="12dp"
            android:elevation="4dp"
            android:layout_marginBottom="8dp">

            <TextView
                style="@style/SectionTitleStyle"
                android:text="📋 Activity History" />

            <ScrollView
                android:id="@+id/history_scroll_view"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@color/background_light"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:scrollbarStyle="insideOverlay"
                android:scrollbarThumbVertical="@color/border_medium"
                android:scrollbarTrackVertical="@color/border_light"
                android:overScrollMode="always"
                android:fadeScrollbars="false"
                android:nestedScrollingEnabled="true">

                <TextView
                    android:id="@+id/history_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No activities logged yet.\nClick 'START LOGGING' to begin tracking your time."
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:fontFamily="monospace" />

            </ScrollView>

        </LinearLayout>

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Made with ❤️ for productivity"
        android:textSize="10sp"
        android:textColor="@color/text_hint"
        android:layout_gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp" />

</LinearLayout>